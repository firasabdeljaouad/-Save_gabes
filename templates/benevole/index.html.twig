{% extends 'base.html.twig' %}

{% block title %}Rejoindre l'activité{% endblock %}

{% block body %}
    <!-- bradcam_area_start -->
    <div class="bradcam_area breadcam_bg overlay d-flex align-items-center justify-content-center">
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="bradcam_text text-center">
                        <h3>Rejoindre l'activité</h3>
                        <p class="text-white mt-2">{{ activite.title }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- bradcam_area_end -->

    <div class="service_area pt-120 pb-120">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card shadow-lg border-0 rounded-3">
                        <div class="card-header text-white text-center py-4" style="background-color: #3CC78F; border-radius: 1rem 1rem 0 0;">
                            <h3 class="mb-0 text-white" style="font-family: 'Yeseva One', cursive;">Devenir Bénévole</h3>
                            <p class="mb-0 mt-2 text-white-50">Remplissez le formulaire ci-dessous pour participer</p>
                        </div>
                        <div class="card-body p-5">
                            
                            {% for message in app.flashes('success') %}
                                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                                    <i class="fa fa-check-circle me-2"></i>{{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}

                            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
                                
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-secondary">Nom Complet</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="fa fa-user"></i>
                                        </span>
                                        {{ form_widget(form.nom, {
                                            'attr': {
                                                'class': 'form-control border-start-0 ps-3 py-3', 
                                                'placeholder': 'Votre nom complet'
                                            }
                                        }) }}
                                    </div>
                                    <div class="text-danger small mt-1">
                                        {{ form_errors(form.nom) }}
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-secondary">Adresse Email</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="fa fa-envelope"></i>
                                        </span>
                                        {{ form_widget(form.email, {
                                            'attr': {
                                                'class': 'form-control border-start-0 ps-3 py-3', 
                                                'placeholder': 'votre.email@exemple.com'
                                            }
                                        }) }}
                                    </div>
                                    <div class="text-danger small mt-1">
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-secondary">Numéro de Téléphone</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="fa fa-phone"></i>
                                        </span>
                                        {{ form_widget(form.telephone, {
                                            'attr': {
                                                'class': 'form-control border-start-0 ps-3 py-3', 
                                                'placeholder': '+216 12 345 678'
                                            }
                                        }) }}
                                    </div>
                                    <div class="text-danger small mt-1">
                                        {{ form_errors(form.telephone) }}
                                    </div>
                                </div>

                                <div class="d-grid gap-2 mt-5">
                                    {{ form_widget(form.submit, {
                                        'label': 'Confirmer l\'inscription',
                                        'attr': {
                                            'class': 'btn text-white py-3 fw-bold shadow-sm',
                                            'style': 'background-color: #3CC78F; transition: all 0.3s;'
                                        }
                                    }) }}
                                    <a href="{{ path('app_activite_details', {'id': activite.id}) }}" class="btn btn-outline-secondary py-3 fw-bold">
                                        Retour aux détails
                                    </a>
                                </div>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control:focus {
            border-color: #3CC78F;
            box-shadow: 0 0 0 0.25rem rgba(60, 199, 143, 0.25);
        }
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
{% endblock %}
