{% extends "dashboard.html.twig" %}
{% block title %}Gestion des Activités{% endblock %}

{% block body %}
    <div class="container-fluid px-4 py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1" style="font-family: 'Yeseva One', cursive;">Gestion des Activités</h2>
                <p class="text-muted">Gérez toutes les activités de l'association</p>
            </div>
            <a href="{{ path('app_activite_new') }}" class="btn text-white fw-bold px-4 py-2 rounded-pill shadow-sm" style="background-color: #3CC78F;">
                <i class="fa fa-plus me-2"></i>Nouvelle Activité
            </a>
        </div>

        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr style="border-bottom: 2px solid #3CC78F;">
                                <th class="py-4 ps-4 text-secondary text-uppercase small fw-bold" style="width: 100px;">Image</th>
                                <th class="py-4 text-secondary text-uppercase small fw-bold">Titre & Description</th>
                                <th class="py-4 text-secondary text-uppercase small fw-bold">Date & Lieu</th>
                                <th class="py-4 text-end pe-4 text-secondary text-uppercase small fw-bold" style="min-width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for activite in activites_list %}
                                <tr>
                                    <td class="ps-4">
                                        <div class="rounded-3 overflow-hidden shadow-sm position-relative" style="width: 80px; height: 80px;">
                                            {% if activite.image %}
                                                <img src="{{ asset('uploads/activites/' ~ activite.image) }}" 
                                                     alt="{{ activite.title }}" 
                                                     class="w-100 h-100 object-fit-cover">
                                            {% else %}
                                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted">
                                                    <i class="fa fa-image fa-2x opacity-25"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        <h6 class="fw-bold text-dark mb-1">{{ activite.title }}</h6>
                                        <p class="text-muted small mb-0" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            {{ activite.description }}
                                        </p>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="badge bg-light text-dark border w-auto align-self-start">
                                                <i class="fa fa-calendar me-1 text-success"></i>
                                                {{ activite.date ? activite.date|date('d M Y') : 'N/A' }}
                                            </span>
                                            <span class="small text-muted">
                                                <i class="fa fa-map-marker me-1 text-danger"></i>
                                                {{ activite.lieu }}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="{{ path('app_activite_edit', {id: activite.id}) }}" 
                                               class="btn btn-outline-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                                               style="width: 35px; height: 35px;"
                                               title="Modifier">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            
                                            <form method="post" action="{{ path('app_activite_delete', {id: activite.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette activité ?');" class="d-inline-block">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activite.id) }}">
                                                <button type="submit" 
                                                        class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center"
                                                        style="width: 35px; height: 35px;"
                                                        title="Supprimer">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                            
                                            <a href="{{ path('app_activite_details', {id: activite.id}) }}" 
                                               class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                                               style="width: 35px; height: 35px;"
                                               title="Voir les détails">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center text-muted opacity-50">
                                            <i class="fa fa-folder-open-o fa-3x mb-3"></i>
                                            <p class="mb-0">Aucune activité trouvée</p>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="card-footer bg-white border-top-0 py-4 d-flex justify-content-center">
                    {{ knp_pagination_render(activites_list) }}
                </div>
            </div>
        </div>
    </div>

    <style>
        .object-fit-cover {
            object-fit: cover;
        }
        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
        }
    </style>
{% endblock %}
