{% extends 'dashboard.html.twig' %}
{% block title %}Ajouter une Activité{% endblock %}

{% block body %}
    <div class="container-fluid px-4 py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #1F8B4C, #3CC78F);">
                        <div class="d-flex align-items-center">
                            <span class="material-symbols-rounded fs-1 me-3 bg-white text-success rounded-circle p-2 shadow-sm">add_circle</span>
                            <div>
                                <h3 class="mb-1 text-white fw-bold" style="font-family: 'Inter', sans-serif;">Nouvelle Activité</h3>
                                <p class="mb-0 opacity-75">Remplissez les informations ci-dessous pour créer une activité.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body p-5 bg-white">
                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        
                        <div class="row g-4">
                            <!-- Title -->
                            <div class="col-12">
                                <label class="form-label fw-bold text-secondary">Titre de l'activité</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-font text-muted"></i>
                                    </span>
                                    {{ form_widget(form.title, {'attr': {'class': 'form-control border-start-0 ps-3 py-3', 'placeholder': 'Ex: Nettoyage de la plage'}}) }}
                                </div>
                                <div class="text-danger small mt-1">{{ form_errors(form.title) }}</div>
                            </div>

                            <!-- Date & Lieu -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Date de l'événement</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-calendar text-muted"></i>
                                    </span>
                                    {{ form_widget(form.date, {'attr': {'class': 'form-control border-start-0 ps-3 py-3'}}) }}
                                </div>
                                <div class="text-danger small mt-1">{{ form_errors(form.date) }}</div>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">Lieu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-map-marker text-muted"></i>
                                    </span>
                                    {{ form_widget(form.lieu, {'attr': {'class': 'form-control border-start-0 ps-3 py-3', 'placeholder': 'Ex: Gabès, Plage'}}) }}
                                </div>
                                <div class="text-danger small mt-1">{{ form_errors(form.lieu) }}</div>
                            </div>

                            <!-- Image -->
                            <div class="col-12">
                                <label class="form-label fw-bold text-secondary">Image de couverture</label>
                                <div class="upload-zone p-4 text-center border rounded-3 bg-light position-relative" style="border: 2px dashed #cbd5e1 !important; transition: all 0.3s ease;">
                                    <i class="fa fa-cloud-upload fa-3x text-muted mb-3 opacity-50"></i>
                                    <p class="small text-muted mb-3">Cliquez ou glissez une image ici</p>
                                    {{ form_widget(form.image, {'attr': {'class': 'form-control visually-hidden', 'onchange': 'updateFileName(this)'}}) }}
                                    <label for="activite_image" class="btn btn-outline-success rounded-pill px-4 shadow-sm">
                                        <i class="fa fa-folder-open me-2"></i>Choisir un fichier
                                    </label>
                                    <div id="file-name-display" class="mt-3 fw-bold text-success small"></div>
                                </div>
                                <div class="text-danger small mt-1">{{ form_errors(form.image) }}</div>
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <label class="form-label fw-bold text-secondary">Description</label>
                                {{ form_widget(form.description, {'attr': {'class': 'form-control p-3', 'rows': '5', 'placeholder': 'Décrivez les détails de l\'activité...'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                            <a href="{{ path('app_activite_index') }}" class="btn btn-light px-4 fw-bold text-secondary border">Annuler</a>
                            {{ form_widget(form.sauvegarder, {
                                'label': '<i class="fa fa-save me-2"></i>Enregistrer l\'activité',
                                'label_html': true,
                                'attr': {'class': 'btn btn-success px-5 fw-bold text-white shadow-sm', 'style': 'background-color: #1F8B4C; border: none; padding-top: 12px; padding-bottom: 12px;'}
                            }) }}
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control:focus, .form-select:focus {
            border-color: #1F8B4C;
            box-shadow: 0 0 0 0.25rem rgba(31, 139, 76, 0.25);
        }
        .upload-zone:hover {
            background-color: #f0fdf4 !important;
            border-color: #1F8B4C !important;
            transform: translateY(-2px);
        }
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>

    <script>
        function updateFileName(input) {
            var fileName = input.files[0] ? input.files[0].name : '';
            document.getElementById('file-name-display').innerHTML = fileName ? '<i class="fa fa-check-circle me-1"></i> ' + fileName : '';
        }
    </script>
{% endblock %}
